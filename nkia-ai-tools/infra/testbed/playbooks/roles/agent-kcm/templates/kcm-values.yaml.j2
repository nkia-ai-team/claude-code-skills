# Auto-generated by ansible — testbed-build orchestrator (NKIAAI-542).
# 직접 편집 금지. inventory host_vars 또는 group_vars 변경 후 재배포.
#
# Schema: lucida-kcmagent/deploy/kcm-agent/values.yaml (helm chart default).

# Cluster name (KCM dashboard 표시명)
clusterName: "{{ app_namespace }}"

# 컨테이너 이미지 — controller 에서 build → ctr import 한 local image
image: "{{ kcm_image_name }}:{{ kcm_agent_version }}-{{ target_arch }}"

# local image 라 IfNotPresent (Always 면 K3s 가 외부 registry pull 시도 → fail)
pullPolicy: "IfNotPresent"

# multi-tenant 분리: master/node Deployment·DaemonSet·ServiceAccount·ClusterRole·
# ClusterRoleBinding 의 metadata.name 이 모두 helm chart template 에서 이 값으로
# 생성됨. testbed 별로 다른 release 가 같은 K3s 클러스터에 공존하려면 testbed
# 식별자 (app_namespace) prefix 가 필수. 같은 ClusterRole 이름 충돌 시 helm install
# 자체가 실패.
master:
  name: "{{ app_namespace }}-kcm-master"
node:
  name: "{{ app_namespace }}-kcm-node"

# ================================================================
# KCM Backend Connection
# ================================================================
kcm:
  # Polestar10 의 organization_id (24-hex SAAS_TENANT_ID).
  # 빈값이면 master agent 가 backend 등록 실패.
  orgId: "{{ polestar_organization_id }}"

  # Polestar10 KCM backend 주소 (host:port)
  addr: "{{ polestar10_collector_host }}:{{ polestar10_kcm_collector_port | default(20040) }}"

  # 인증 토큰 — testing 환경 (RCA 테스트베드) 에선 빈값 + insecure: true 로 skip 가능.
  # 운영 환경에서는 Polestar10 web UI 의 KCM 메뉴에서 발급된 token 을
  # bootstrap.yaml / inventory host vars 의 polestar10_kcm_token 으로 주입.
  token: "{{ polestar10_kcm_token | default('') }}"

  # internal network 이라 TLS 검증 skip
  insecure: {{ polestar10_kcm_insecure | default(true) | bool | lower }}
