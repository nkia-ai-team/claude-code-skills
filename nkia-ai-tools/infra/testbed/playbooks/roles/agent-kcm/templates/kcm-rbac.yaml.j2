---
apiVersion: v1
kind: Namespace
metadata:
  name: kcm
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: kcm-agent
  namespace: kcm
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: kcm-agent
rules:
  - apiGroups: [""]
    resources: [nodes, nodes/proxy, nodes/metrics, pods, services, namespaces]
    verbs: [get, list, watch]
  - apiGroups: ["metrics.k8s.io"]
    resources: [nodes, pods]
    verbs: [get, list]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: kcm-agent
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: kcm-agent
subjects:
  - kind: ServiceAccount
    name: kcm-agent
    namespace: kcm
